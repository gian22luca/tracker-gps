# Copiar a .env y completar antes de correr en produccion.
# En desarrollo local, si no existe .env, settings.py usa valores por
# defecto seguros para desarrollo (DEBUG=true, SECRET_KEY de ejemplo).

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-random-en-produccion
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.vixel.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://panel.vixel.example.com
